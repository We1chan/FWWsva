+
+    @staticmethod
+    def _decode_ptz_command(value: str, count: int = 1) -> dict:
+        """Decode the eight-byte GB28181 A.3.1 PTZ command used by WVP."""
+        if not re.fullmatch(r"[0-9A-Fa-f]{16}", value or ""):
+            raise ValueError("PTZCmd must contain exactly 16 hexadecimal characters")
+        raw = bytes.fromhex(value)
+        if raw[:3] != bytes((0xA5, 0x0F, 0x01)):
+            raise ValueError("unsupported PTZCmd header")
+        if sum(raw[:7]) % 0x100 != raw[7]:
+            raise ValueError("PTZCmd checksum mismatch")
+
+        code = raw[3]
+        movements = []
+        if code & 0x02:
+            movements.append("left")
+        elif code & 0x01:
+            movements.append("right")
+        if code & 0x08:
+            movements.append("up")
+        elif code & 0x04:
+            movements.append("down")
+        if code & 0x10:
+            movements.append("zoomin")
+        elif code & 0x20:
+            movements.append("zoomout")
+
+        return {
+            "command": "+".join(movements) if movements else "stop",
+            "pan_speed": raw[4],
+            "tilt_speed": raw[5],
+            "zoom_speed": raw[6] >> 4,
+            "count": count,
+        }
