diff --git a/test_gb28181_pusher.py b/test_gb28181_pusher.py
new file mode 100644
index 0000000..463c92c
--- /dev/null
+++ b/test_gb28181_pusher.py
@@ -0,0 +1,79 @@
+import unittest
+
+from gb28181_pusher import GB28181Pusher
+
+
+class PtzCommandTest(unittest.TestCase):
+
+    def test_decodes_left_command_from_wvp(self):
+        # A5 0F 01 02 80 40 F0 67: left, pan=128, tilt=64, zoom=15.
+        state = GB28181Pusher._decode_ptz_command("A50F01028040F067", 4)
+        self.assertEqual("left", state["command"])
+        self.assertEqual(128, state["pan_speed"])
+        self.assertEqual(64, state["tilt_speed"])
+        self.assertEqual(15, state["zoom_speed"])
+        self.assertEqual(4, state["count"])
+
+    def test_decodes_diagonal_and_stop(self):
+        diagonal = GB28181Pusher._decode_ptz_command("A50F010A32320023")
+        self.assertEqual("left+up", diagonal["command"])
+        stopped = GB28181Pusher._decode_ptz_command("A50F0100000000B5")
+        self.assertEqual("stop", stopped["command"])
+
+    def test_rejects_invalid_checksum(self):
+        with self.assertRaisesRegex(ValueError, "checksum"):
+            GB28181Pusher._decode_ptz_command("A50F01028040F000")
+
+    def test_device_control_message_updates_observable_state(self):
+        pusher = GB28181Pusher(
+            server_ip="127.0.0.1", server_id="44010200492000000001",
+            agent_id="44010200491320000001", agent_password="test",
+            channel_id="44010200491310000001", local_ip="127.0.0.1",
+        )
+        sent = []
+        pusher._local_port = 15060
+        pusher._send = sent.append
+        message = (
+            "MESSAGE sip:device SIP/2.0\r\n"
+            "Via: SIP/2.0/UDP 127.0.0.1:5060;branch=z9\r\n"
+            "From: <sip:server>;tag=1\r\nTo: <sip:device>\r\n"
+            "Call-ID: ptz-1\r\nCSeq: 1 MESSAGE\r\n\r\n"
+            "<Control><CmdType>DeviceControl</CmdType><SN>1</SN>"
+            "<DeviceID>44010200491310000001</DeviceID>"
+            "<PTZCmd>A50F010A32320023</PTZCmd></Control>"
+        )
+
+        pusher._handle_message(message)
+
+        self.assertEqual("left+up", pusher.ptz_state["command"])
+        self.assertEqual(1, pusher.ptz_state["count"])
+        self.assertTrue(sent[0].startswith(b"SIP/2.0 200 OK"))
+
+    def test_config_query_advertises_fast_heartbeat(self):
+        pusher = GB28181Pusher(
+            server_ip="127.0.0.1", server_id="44010200492000000001",
+            agent_id="44010200491320000001", agent_password="test",
+            channel_id="44010200491310000001", local_ip="127.0.0.1",
+            heartbeat_interval=10, heartbeat_count=2,
+        )
+        sent = []
+        pusher._local_port = 15060
+        pusher._send = sent.append
+        message = (
+            "MESSAGE sip:device SIP/2.0\r\n"
+            "Via: SIP/2.0/UDP 127.0.0.1:5060;branch=z9\r\n"
+            "From: <sip:server>;tag=1\r\nTo: <sip:device>\r\n"
+            "Call-ID: config-1\r\nCSeq: 2 MESSAGE\r\n\r\n"
+            "<Query><CmdType>ConfigDownload</CmdType><SN>2</SN>"
+            "<DeviceID>44010200491320000001</DeviceID></Query>"
+        )
+
+        pusher._handle_message(message)
+
+        response = sent[1].decode("gb2312")
+        self.assertIn("<HeartBeatInterval>10</HeartBeatInterval>", response)
+        self.assertIn("<HeartBeatCount>2</HeartBeatCount>", response)
+
+
+if __name__ == "__main__":
+    unittest.main()
