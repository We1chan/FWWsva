+                    f"<?xml version='1.0' encoding='GB2312'?><Response>"
+                    f"<CmdType>ConfigDownload</CmdType><SN>{sn}</SN><DeviceID>{self.agent_id}</DeviceID>"
+                      f"<Result>OK</Result><BasicParam><Name>{DEVICENAME}</Name><Expiration>3600</Expiration>"
+                      f"<HeartBeatInterval>{self.heartbeat_interval}</HeartBeatInterval>"
+                      f"<HeartBeatCount>{self.heartbeat_count}</HeartBeatCount>"
