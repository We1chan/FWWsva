[Unit]
Description=easySVA GB28181 software camera (test3)
After=network.target easysva-wvp.service easysva-rtsp-simulator-3.service
Requires=easysva-wvp.service easysva-rtsp-simulator-3.service

[Service]
Type=simple
Environment=GB28181_DEVICE_ID=44010200491320000003
Environment=GB28181_CHANNEL_ID=44010200491320000013
Environment=GB28181_LOCAL_PORT=15063
Environment=GB28181_SIMULATOR_SOURCE=rtsp://127.0.0.1:9994/live/mock-camera-3
ExecStart=/opt/SVA/gb28181/easysva-gb-simulator-launcher.sh
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
