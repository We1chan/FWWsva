[Unit]
Description=easySVA internal test6 source for the GB28181 software camera
After=network.target easysva-media.service
Requires=easysva-media.service

[Service]
Type=simple
ExecStart=/opt/SVA/server/easysva-rtsp-simulator.sh /opt/SVA/samples/test6.mp4 rtsp://127.0.0.1:9994/live/mock-camera
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
