[Unit]
Description=easySVA analyzer
After=network.target easysva-backend.service easysva-media.service
Requires=easysva-backend.service easysva-media.service

[Service]
Type=simple
WorkingDirectory=/opt/SVA/server
Environment=LD_LIBRARY_PATH=/usr/local/onnxruntime/lib:/usr/local/lib:/usr/lib/x86_64-linux-gnu
ExecStart=/opt/SVA/server/Analyzer -f /opt/SVA/config.json
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
