# 模块：流媒体协议组 / GB28181 信令服务。
# 数据库、Redis 与国标媒体服务就绪后启动 WVP。
[Unit]
Description=easySVA GB28181 signaling service (WVP)
Wants=network-online.target
After=network-online.target mariadb.service redis-server.service easysva-gb-media.service
Requires=mariadb.service redis-server.service easysva-gb-media.service

[Service]
Type=simple
WorkingDirectory=/opt/SVA/wvp
ExecStart=/opt/SVA/wvp/easysva-wvp-launcher.sh
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
