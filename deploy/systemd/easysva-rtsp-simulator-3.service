[Unit]
Description=easySVA simulated RTSP camera 3 (test3)
After=network.target easysva-media.service
Requires=easysva-media.service

[Service]
Type=simple
ExecStart=/usr/bin/ffmpeg -hide_banner -loglevel warning -re -stream_loop -1 -i /opt/SVA/samples/test3.mp4 -map 0:v:0 -an -vf scale=1280:-2,format=yuv420p -c:v h264_nvenc -preset p1 -tune ll -g 30 -bf 0 -f rtsp -rtsp_transport tcp rtsp://127.0.0.1:9994/live/mock-camera-3
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
