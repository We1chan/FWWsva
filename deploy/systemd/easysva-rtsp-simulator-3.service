[Unit]
Description=easySVA simulated RTSP camera 3 (test3)
After=network.target easysva-media.service
Requires=easysva-media.service

[Service]
Type=simple
ExecStart=/opt/SVA/server/easysva-rtsp-simulator.sh /opt/SVA/samples/test3.mp4 rtsp://127.0.0.1:9994/live/mock-camera-3
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
